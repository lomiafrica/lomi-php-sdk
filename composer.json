{
    "name": "lomi/lomi-sdk",
    "description": "Payment processing API for francophone West African businesses.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://docs.lomi.africa/build/sdks/php",
    "license": "unlicense",
    "authors": [
        {
            "name": "lomi.",
            "email": "hello@lomi.africa",
            "homepage": "https://lomi.africa"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Lomi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lomi\\Tests\\": "tests/"
        }
    }
}
